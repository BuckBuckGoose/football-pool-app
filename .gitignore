## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/

# Visual Studio 2015 cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
**/Properties/launchSettings.json

# Database files
*.db
*.db-shm
*.db-wal

# Migrations - Keep migrations in source control
# **/Migrations/

# User secrets - Keep development settings
# appsettings.*.json

# Rider
.idea/
*.sln.iml

# Node modules and client libraries (these should be restored via package managers)
node_modules/
wwwroot/lib/
