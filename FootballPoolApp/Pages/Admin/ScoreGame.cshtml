@page "{id:int}"
@model FootballPoolApp.Pages.Admin.ScoreGameModel
@{
    ViewData["Title"] = "Score Game";
}

<h1>Score Game</h1>

<div class="row">
    <div class="col-md-6">
        <h3>@Model.Game.Favorite vs @Model.Game.Underdog</h3>
        <p><strong>Week:</strong> @Model.Game.Week</p>
        <p><strong>League:</strong> @Model.Game.League</p>
        <p><strong>Spread:</strong> @Model.Game.Favorite -@Model.Game.Spread</p>
        
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Game.Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="Game.FavoriteScore" class="control-label">Favorite Score</label>
                <input asp-for="Game.FavoriteScore" class="form-control" type="number" />
                <span asp-validation-for="Game.FavoriteScore" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Game.UnderdogScore" class="control-label">Underdog Score</label>
                <input asp-for="Game.UnderdogScore" class="form-control" type="number" />
                <span asp-validation-for="Game.UnderdogScore" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Save Score</button>
                <a asp-page="./Games" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
